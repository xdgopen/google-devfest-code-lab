# ===================== Gemini authentication =====================
# Local (codelab step 5): Google AI Studio key → https://aistudio.google.com
GOOGLE_API_KEY=your_api_key
# Cloud Run: use Vertex AI through the service account instead (no key):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# ===================== Model & agent =====================
MODEL=gemini-flash-latest
MAX_LOOP_ITERATIONS=3
ENABLE_RESEARCH=false

# ===================== Persistence =====================
# Empty → in-memory sessions. docker-compose overrides this with its Postgres.
# DATABASE_URL=postgresql://blogger:blogger@localhost:5432/blogger
# ARTIFACT_BUCKET=my-bucket-name

# ===================== Memory =====================
ENABLE_MEMORY=true
# Vertex AI Memory Bank (optional): agentengine://<agent_engine_id>
# MEMORY_SERVICE_URI=

# ===================== Guardrails =====================
MAX_INPUT_CHARS=2000
MAX_TOOL_CALLS=15
REDACT_PII=true
SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
# Extra comma-separated phrases to refuse:
# BLOCKED_TOPICS=crypto pump,gambling

# ===================== Server =====================
ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
